[Unit]
Description=Dailies review studio (loopback only, published through a Cloudflare Tunnel)
Documentation=https://github.com/coletebou/dailies
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dailies
Group=dailies
EnvironmentFile=/etc/dailies/dailies.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WorkingDirectory=/srv/dailies/app/current/server
ExecStart=/srv/dailies/app/venv/bin/python -m dailies_server
Restart=on-failure
RestartSec=5
Nice=5
# Build cut and proxy warm-up run ffmpeg; cap them so a shared box stays responsive.
MemoryHigh=6G
MemoryMax=8G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# The only writable tree: notes/studio, renders/studio and the proxy cache live inside the project.
ReadWritePaths=/srv/dailies/projects
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
