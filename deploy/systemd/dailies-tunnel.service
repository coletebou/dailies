[Unit]
Description=Cloudflare Tunnel for Dailies (dailies.example.com -> 127.0.0.1:8765)
After=network-online.target dailies.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/dailies.yml tunnel run
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
